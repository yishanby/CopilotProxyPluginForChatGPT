{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.mjs\" hook",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -File \"${PLUGIN_ROOT}/hooks/start.ps1\"",
            "timeout": 30,
            "statusMessage": "Starting your local Copilot provider"
          }
        ]
      }
    ]
  }
}
